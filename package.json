{
  "name": "budget-app",
  "private": true,
  "type": "module",
  "version": "3.0.0",
  "packageManager": "pnpm@11.5.0",
  "repository": {
    "url": "https://github.com/larsrickert/budget-app"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepare": "simple-git-hooks",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/source-code-pro": "^5.2.7",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@sit-onyx/chartjs-plugin": "^1.0.0",
    "@sit-onyx/flags": "^1.2.0",
    "@sit-onyx/icons": "^1.9.1",
    "@sit-onyx/nuxt": "^1.0.1",
    "@sit-onyx/tiptap": "~0.2.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "chart.js": "^4.5.1",
    "drizzle-orm": "~0.45.2",
    "drizzle-zod": "~0.8.3",
    "nuxt": "^4.4.6",
    "nuxt-auth-utils": "~0.5.29",
    "pg": "^8.21.0",
    "sit-onyx": "^1.13.1",
    "vue": "^3.5.35",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@types/node": "^24.12.4",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "~0.31.10",
    "eslint": "^10.4.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "sass-embedded": "^1.100.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  }
}
